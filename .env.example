# Copy to .env for local dev (gitignored). In production these are injected at build
# time from GitHub Actions repo secrets - see .github/workflows/deploy.yml.

VITE_WORKER_BASE_URL=https://running-app-api.reedwkc.workers.dev
# Must match the APP_SHARED_SECRET set on the Worker via `wrangler secret put`.
# Not a real secret once built - it ships in the public JS bundle either way - this
# just keeps it out of the committed source, see worker/src/security.js for why.
VITE_APP_SHARED_SECRET=
